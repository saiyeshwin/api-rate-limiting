    {
      "name": "4. API Key Generation & Management",
      "item": [
        {
          "name": "TC_KEY_001: Generate API Key [Functional]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Returns plain text key and key prefix on creation', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('plain_key');",
                  "    pm.expect(jsonData.plain_key).to.match(/^ap_[a-f0-9]{48}$/);",
                  "    pm.expect(jsonData.key_prefix).to.match(/^ap_[a-f0-9]{7}\\.\\.\\.$/);",
                  "    ",
                  "    // Save credentials to environment",
                  "    pm.environment.set('apiKeyId', jsonData.id);",
                  "    pm.environment.set('plainApiKey', jsonData.plain_key);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"api_id\": \"{{apiId}}\",\n  \"name\": \"QE Functional Test Key\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/keys",
              "host": ["{{baseUrl}}"],
              "path": ["api", "keys"]
            }
          }
        },
        {
          "name": "TC_KEY_002: List API Keys for Endpoint [Functional]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Lists keys and strictly omits plain secrets for security', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.at.least(1);",
                  "    jsonData.forEach(k => {",
                  "        pm.expect(k).to.not.have.property('plain_key');",
                  "        pm.expect(k).to.not.have.property('key_hash');",
                  "        pm.expect(k).to.have.property('key_prefix');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
