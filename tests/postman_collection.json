    {
      "name": "1. Platform Health Check",
      "item": [
        {
          "name": "TC_HLTH_001: Platform System Health Status [Functional]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Platform reports healthy status', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    pm.expect(jsonData.status).to.eql('ok');",
                  "    pm.expect(jsonData).to.have.property('service');",
                  "    pm.expect(jsonData.service).to.eql('API Observability Platform');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication & Security",
      "item": [
        {
          "name": "TC_AUTH_001: Register New User [Functional]",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomId = Date.now();",
                  "pm.environment.set('userEmail', `qe_user_${randomId}@example.com`);",
                  "pm.environment.set('userName', `QE Engineer ${randomId}`);",
                  "pm.environment.set('userPassword', 'SecurePass123!');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response contains valid JWT token and user credentials', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.token).to.be.a('string').and.have.lengthOf.at.least(20);",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.email).to.eql(pm.environment.get('userEmail'));",
                  "    ",
                  "    // Save dynamic token and userId to environment",
                  "    pm.environment.set('authToken', jsonData.token);",
                  "    pm.environment.set('userId', jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
