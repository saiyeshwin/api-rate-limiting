              "mode": "raw",
              "raw": "{\n  \"name\": \"QE Target Endpoint (Sliding Window)\",\n  \"endpoint\": \"https://jsonplaceholder.typicode.com/todos/1\",\n  \"method\": \"GET\",\n  \"rate_limit\": 3,\n  \"rate_window\": 10,\n  \"rate_limit_strategy\": \"sliding_window\",\n  \"description\": \"Automated test endpoint\"\n}"
